# Copia este archivo como .env y ajusta los valores.

# Con una API key real los agentes usan Claude; sin ella corre el modo demo simulado.
ANTHROPIC_API_KEY=

# Opcional: búsqueda semántica con embeddings de Voyage AI (pip install -e ".[rag]").
VOYAGE_API_KEY=

# auto | anthropic | fake
ORQUESTA_LLM_MODE=auto
ORQUESTA_MODEL=claude-opus-5-5

# SQLite local (por defecto) o PostgreSQL:
# ORQUESTA_DATABASE_URL=postgresql+asyncpg://orquesta:orquesta@localhost:5432/orquesta
ORQUESTA_DATABASE_URL=sqlite+aiosqlite:///./orquesta.db

# Si lo defines, aprobar o denegar acciones exige el header X-Admin-Token.
ORQUESTA_ADMIN_TOKEN=
